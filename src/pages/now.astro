---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const title = `Now | ${SITE.title}`;
const description =
  "What I'm currently focused on - projects, learning, and life.";
---

<Layout title={title} description={description}>
  <Header activeNav="now" />

  <main id="main-content" class="app-layout pt-8 pb-12 sm:pt-16 sm:pb-20">
    <div class="mb-10 text-center sm:text-left">
      <h1
        class="inline-block border-b border-border pr-12 pb-4 font-serif text-4xl font-bold tracking-tight italic sm:text-5xl"
      >
        <span class="mr-2 font-sans font-normal text-accent not-italic">/</span
        >now
      </h1>
      <p class="mt-4 max-w-2xl font-sans text-foreground/70">
        A snapshot of what I'm focused on right now. Reading, thinking,
        building.
      </p>
    </div>

    <!-- Bento Grid -->
    <div
      class="mx-auto grid max-w-5xl auto-rows-min grid-cols-1 gap-6 md:grid-cols-12"
    >
      <!-- Current Projects Box (Large, Primary) -->
      <div
        class="metal-card metal-card-hover bg-noise group p-6 sm:p-8 md:col-span-8"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 transition-opacity group-hover:opacity-100"
        >
        </div>
        <div
          class="mb-3 font-mono text-xs tracking-wider text-accent uppercase"
        >
          Current Projects
        </div>
        <h2 class="mb-4 font-serif text-2xl font-bold">
          Building Defense Systems
        </h2>
        <div class="space-y-4">
          <div class="rounded-xl border border-border/50 bg-background/50 p-4">
            <h3 class="text-lg font-semibold text-foreground">KubeSiphon</h3>
            <p class="mt-1 text-sm text-foreground/70">
              Implementing Per-Pod Policy Routing configurations for Kubernetes
              environments.
            </p>
          </div>
          <div class="rounded-xl border border-border/50 bg-background/50 p-4">
            <h3 class="text-lg font-semibold text-foreground">REKD</h3>
            <p class="mt-1 text-sm text-foreground/70">
              Developing an eBPF ransomware detector tracking highly volatile
              hooking anomalies in real-time.
            </p>
          </div>
        </div>
      </div>

      <!-- Current Focus Box (Tall) -->
      <div
        class="metal-card metal-card-hover bg-noise flex transform flex-col justify-center p-6 transition-transform hover:rotate-0 sm:p-8 md:col-span-4 md:rotate-1"
      >
        <div
          class="mb-3 font-mono text-xs tracking-wider text-accent uppercase"
        >
          Deep Divin'
        </div>
        <h2 class="mb-4 font-serif text-2xl font-bold">C++ Internals</h2>
        <p class="mb-6 text-sm leading-relaxed text-foreground/70">
          Stripping away the abstractions to understand memory models, compiler
          optimizations, and building zero-cost abstractions from the ground up.
        </p>
        <div class="my-2 h-px w-full bg-border"></div>
        <p class="mt-4 text-sm leading-relaxed text-foreground/70">
          Also actively leveling up CTF solving methodologies, primarily
          focusing on binary exploitation and reverse engineering.
        </p>
      </div>

      <!-- On Rotation Box -->
      <div
        class="metal-card metal-card-hover bg-noise transform p-6 transition-transform hover:rotate-0 sm:p-8 md:col-span-5 md:-rotate-1"
      >
        <div
          class="mb-3 font-mono text-xs tracking-wider text-[#27c93f] uppercase"
        >
          On Rotation
        </div>
        <h2 class="mb-4 font-serif text-2xl font-bold">Eclectic Mix</h2>
        <p class="text-sm leading-relaxed text-foreground/70">
          My playlist is a chronological disaster. I blend highly niche
          underground tracks with massive mainstream hits without blinking. One
          minute it's obscure synth-wave, the next it's top-40 pop.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span
            class="rounded-md bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent ring-1 ring-accent/20 ring-inset"
            >Underground</span
          >
          <span
            class="rounded-md bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent ring-1 ring-accent/20 ring-inset"
            >Mainstream</span
          >
          <span
            class="rounded-md bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent ring-1 ring-accent/20 ring-inset"
            >Synthwave</span
          >
        </div>
      </div>

      <!-- Life Box -->
      <div
        class="metal-card metal-card-hover bg-noise p-6 sm:p-8 md:col-span-7"
      >
        <div
          class="mb-3 font-mono text-xs tracking-wider text-[#ffbd2e] uppercase"
        >
          Life Status
        </div>
        <h2 class="mb-4 font-serif text-2xl font-bold">Surviving Academia</h2>
        <p class="mb-4 text-sm leading-relaxed text-foreground/70">
          Currently navigating continuous assessments in rigorous coursework.
          It's a balancing act between deep technical research and passing
          exams.
        </p>
        <ul class="mt-4 space-y-2">
          <li class="flex items-center text-sm text-foreground/80">
            <span class="mr-2 text-accent">→</span> Control Systems
          </li>
          <li class="flex items-center text-sm text-foreground/80">
            <span class="mr-2 text-accent">→</span> Numerical Methods
          </li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
