---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import {
  IDENTITY,
  CURRENT_STATUS,
  PROJECTS,
  DISCLOSURES,
  SOCIAL_LINKS,
  SITE,
} from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex).map(post => ({
  year: new Date(post.data.pubDatetime).getFullYear(),
  href: getPath(post.id, post.filePath),
  title: post.data.title,
  excerpt: post.data.description,
}));
---

<Layout
  title={`Hi, I'm ${IDENTITY.firstName} | ${IDENTITY.handle}`}
  description={`Quick introduction to ${IDENTITY.fullName} — ${IDENTITY.role}.`}
>
  <Header />
  <main id="main-content" class="app-layout pt-20 pb-24">
    <div
      class="pointer-events-none fixed inset-0 z-[-1] bg-[radial-gradient(circle,var(--dot-color)_1px,transparent_1px)] bg-[length:24px_24px]"
    >
    </div>

    <section class="py-12 sm:py-16">
      <!-- Name + Role -->
      <h1 class="mb-1 font-serif text-2xl font-normal italic">
        {IDENTITY.fullName}
      </h1>
      <p class="mb-6 text-sm" style="color: var(--text-muted)">
        {IDENTITY.role} · {IDENTITY.handle}
      </p>

      <p
        class="mb-8 text-sm leading-relaxed"
        style="color: var(--text-muted); max-width: 46ch"
      >
        {IDENTITY.bio}
      </p>

      <!-- Links row -->
      <div
        class="mb-10 flex flex-wrap gap-x-5 gap-y-2 text-sm"
        style="color: var(--text-faint)"
      >
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="prose-link">github</a
        >
        <a
          href={SOCIAL_LINKS.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="prose-link">twitter</a
        >
        <a
          href={SOCIAL_LINKS.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="prose-link">linkedin</a
        >
        <a href={SOCIAL_LINKS.email} class="prose-link">email</a>
        <a href="/resume.pdf" class="prose-link">resume ↗</a>
        <a href="/" class="prose-link">← back to site</a>
      </div>

      <hr style="border-color: var(--hr-color); margin-bottom: 2.5rem" />

      <!-- Currently -->
      <div class="mb-10">
        <p
          class="mb-4 font-mono text-xs tracking-widest uppercase"
          style="color: var(--text-faint)"
        >
          Currently
        </p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            CURRENT_STATUS.map(item => (
              <div class="flex gap-3 text-sm">
                <span
                  class="mt-0.5 w-16 shrink-0 font-mono text-xs"
                  style="color: var(--text-faint)"
                >
                  {item.label}
                </span>
                <span style="color: var(--text-muted)">{item.value}</span>
              </div>
            ))
          }
        </div>
      </div>

      <hr style="border-color: var(--hr-color); margin-bottom: 2.5rem" />

      <!-- Disclosures -->
      <div class="mb-10">
        <p
          class="mb-4 font-mono text-xs tracking-widest uppercase"
          style="color: var(--text-faint)"
        >
          Disclosures
        </p>
        <div class="space-y-5">
          {
            DISCLOSURES.map(item => (
              <div style="padding-bottom: 1.25rem; border-bottom: 1px solid var(--subtle-border)">
                <div class="mb-1 flex items-baseline gap-3">
                  <span
                    class="font-mono text-xs"
                    style="color: var(--text-faint)"
                  >
                    {item.year}
                  </span>
                  <a
                    href={item.link}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    class="prose-link text-sm font-medium"
                  >
                    {item.title}
                  </a>
                </div>
                <p
                  class="text-xs leading-relaxed"
                  style="color: var(--text-muted)"
                >
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <hr style="border-color: var(--hr-color); margin-bottom: 2.5rem" />

      <!-- Projects -->
      <div class="mb-10">
        <p
          class="mb-4 font-mono text-xs tracking-widest uppercase"
          style="color: var(--text-faint)"
        >
          Projects
        </p>
        <div class="space-y-5">
          {
            PROJECTS.map(project => (
              <div style="padding-bottom: 1.25rem; border-bottom: 1px solid var(--subtle-border)">
                <div class="mb-1 flex items-baseline gap-3">
                  <span
                    class="font-mono text-xs"
                    style="color: var(--text-faint)"
                  >
                    {project.year}
                  </span>
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="prose-link text-sm font-medium"
                  >
                    {project.title}
                  </a>
                </div>
                <p
                  class="mb-1 text-xs"
                  style="color: var(--text-faint); font-family: var(--font-mono)"
                >
                  {project.stack}
                </p>
                <p
                  class="text-xs leading-relaxed"
                  style="color: var(--text-muted)"
                >
                  {project.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <hr style="border-color: var(--hr-color); margin-bottom: 2.5rem" />

      <!-- Research / Writing -->
      <div class="mb-10">
        <p
          class="mb-4 font-mono text-xs tracking-widest uppercase"
          style="color: var(--text-faint)"
        >
          Writing
        </p>
        <div class="space-y-5">
          {
            recentPosts.map(post => (
              <div style="padding-bottom: 1.25rem; border-bottom: 1px solid var(--subtle-border)">
                <div class="mb-1 flex items-baseline gap-3">
                  <span
                    class="font-mono text-xs"
                    style="color: var(--text-faint)"
                  >
                    {post.year}
                  </span>
                  <a href={post.href} class="prose-link text-sm font-medium">
                    {post.title}
                  </a>
                </div>
                <p
                  class="text-xs leading-relaxed"
                  style="color: var(--text-muted)"
                >
                  {post.excerpt}
                </p>
              </div>
            ))
          }
        </div>
      </div>

    </section>
  </main>
  <Footer />
</Layout>
