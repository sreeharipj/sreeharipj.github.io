---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const title = `Resume | ${SITE.title}`;
const resumeUrl = "/resume.pdf";
---

<Layout title={title}>
  <Header activeNav="resume" />

  <main
    id="main-content"
    class="app-layout flex flex-col items-center pt-8 pb-12 sm:pt-16 sm:pb-20"
  >
    <div
      class="mb-8 flex w-full flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left"
    >
      <h1
        class="inline-block border-b border-border pr-12 pb-4 font-serif text-4xl font-bold tracking-tight italic sm:text-5xl"
      >
        <span class="mr-2 font-sans font-normal text-accent not-italic">/</span
        >resume
      </h1>
      <a
        href={resumeUrl}
        download="Sreehari_Resume.pdf"
        class="flex items-center gap-2 rounded-md bg-accent px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-accent/90"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-download"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        Download PDF
      </a>
    </div>

    <!-- PDF Embed Container -->
    <div
      class="h-[75vh] min-h-[600px] w-full overflow-hidden rounded-xl border border-border bg-[#121212] shadow-2xl"
    >
      <!-- Fallback message shown as placeholder while loading or if object fails -->
      <object data={resumeUrl} type="application/pdf" class="h-full w-full">
        <div
          class="flex h-full flex-col items-center justify-center p-10 text-center"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-file-text mb-4 text-foreground/50"
          >
            <path
              d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" x2="8" y1="13" y2="13"></line>
            <line x1="16" x2="8" y1="17" y2="17"></line>
            <line x1="10" x2="8" y1="9" y2="9"></line>
          </svg>
          <p class="mb-4 font-sans text-lg text-foreground/80">
            Your browser does not support embedding PDFs.
          </p>
          <p class="mb-6 text-sm text-foreground/60">
            But don't worry, you can easily download it to view locally.
          </p>
          <a
            href={resumeUrl}
            download="Sreehari_Resume.pdf"
            class="rounded-md bg-accent px-6 py-3 font-medium text-white transition-colors hover:bg-accent/90"
          >
            Download Resume
          </a>
        </div>
      </object>
    </div>
  </main>

  <Footer />
</Layout>
