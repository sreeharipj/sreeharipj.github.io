---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;
---

<li class="my-6">
  <a
    href={getPath(id, filePath)}
    class="group metal-card metal-card-hover bg-noise block p-6"
  >
    <Heading
      class="text-xl font-medium text-foreground transition-colors group-hover:text-accent"
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>

    {
      tags && tags.length > 0 && (
        <div class="mt-4 mb-2 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="rounded-md bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent ring-1 ring-accent/20 ring-inset">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <p class="mt-4 mb-4 text-sm leading-relaxed text-foreground/70">
      {description}
    </p>

    <div class="mt-4 text-xs opacity-70">
      <Datetime {...props} />
    </div>
  </a>
</li>
